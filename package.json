    "@capacitor/app": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor-community/fcm": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
